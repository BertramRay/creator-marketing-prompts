  "required": [
    "fit_score",
    "verdict",
    "axes",
    "reasons_for",
    "reasons_against"
  ],
  "properties": {
    "fit_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "verdict": {
      "type": "string",
